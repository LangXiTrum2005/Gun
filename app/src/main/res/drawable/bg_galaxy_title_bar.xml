<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/galaxy_surface_high"
                android:centerColor="@color/galaxy_surface"
                android:endColor="@color/galaxy_bg_deep"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="@color/galaxy_tech_glow" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="8dp"
        android:right="8dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/galaxy_tech_line"
                android:dashGap="10dp"
                android:dashWidth="28dp" />
        </shape>
    </item>
    <item
        android:bottom="6dp"
        android:left="16dp"
        android:right="16dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#1AFFFFFF"
                android:centerColor="@android:color/transparent"
                android:endColor="#18B78CFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
