<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp" />
            <solid android:color="@color/galaxy_panel" />
            <stroke
                android:width="1dp"
                android:color="@color/galaxy_tech_glow" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp" />
            <gradient
                android:angle="0"
                android:startColor="#188EDFFF"
                android:centerColor="@android:color/transparent"
                android:endColor="#16B78CFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/galaxy_border" />
        </shape>
    </item>
</layer-list>
