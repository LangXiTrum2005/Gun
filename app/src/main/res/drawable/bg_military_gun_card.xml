<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/military_surface" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/bg_camo_card"
            android:gravity="center" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/military_scrim_soft"
                android:endColor="@color/military_scrim"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="@color/military_border_strong" />
        </shape>
    </item>
</layer-list>
