<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/bg_camo_military_dark"
            android:gravity="center" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
