<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/galaxy_surface_high"
                android:centerColor="@color/galaxy_surface"
                android:endColor="@color/galaxy_bg_deep"
                android:type="linear" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_galaxy_hud_frame" />
</layer-list>
