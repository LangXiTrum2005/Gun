<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Real Camo Background -->
    <item>
        <bitmap
            android:src="@drawable/bg_camo_military"
            android:gravity="center" />
    </item>
    <!-- 2. Subtle Dark Tactical Vignette for Contrast & Readability -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#660D120B"
                android:centerColor="#33000000"
                android:endColor="#880A0E08"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
